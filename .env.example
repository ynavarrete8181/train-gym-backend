APP_NAME="Revive"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
NOTIFICACIONES_TIMEZONE=America/Guayaquil
NOTIFICACIONES_CORREOS_POR_MINUTO=10

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5178,http://127.0.0.1:5178

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=db_gimnasio
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=revive-local-app
REVERB_APP_KEY=revive-local-key
REVERB_APP_SECRET=revive-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

FILESYSTEM_DISK=local
# En desarrollo `composer run dev` levanta automáticamente API, colas y Reverb.
# En producción usar supervisor/systemd para mantener los procesos activos.
QUEUE_CONNECTION=database

# En desarrollo se usa archivo para que Reverb y el rate limiter no dependan
# de PostgreSQL solo para operaciones de cache. En producción puede usarse Redis.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="revive@local.test"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5178
USER_ACTIVATION_HOURS=48
AZURE_TENANT_ID=
AZURE_CLIENT_ID_OUTLOOK_GRAPH=
AZURE_CLIENT_SECRET_OUTLOOK_GRAPH=
AZURE_SCOPE=https://graph.microsoft.com/.default
AZURE_OUTLOOK_SENDER=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
